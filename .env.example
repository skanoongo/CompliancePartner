# Copy to .env and edit.   cp .env.example .env
#
# --- Secrets backend ----------------------------------------------------------
# A Doppler service token (dp.st....), scoped to one project and config. Its
# presence selects Doppler as the SOLE source of per-system credentials -
# config/environments.yaml is then not read at all. That is deliberate: a
# fallback that quietly reads a file on disk is how a run ends up authenticating
# with a credential that was rotated precisely because it should not be used.
#
# Without a token the YAML file is used, so a checkout with no Doppler access
# still works.
#
# Doppler holds one secret per field, named ENVIRONMENTS_<SYSTEM>_<FIELD>:
#   ENVIRONMENTS_WORKATO_PASSWORD, ENVIRONMENTS_NETSUITE_ACCOUNT_ID, ...
# The naming is the schema - a new system needs secrets, not code.
DOPPLER_TOKEN=

# --- Everything below is configuration, not secrets --------------------------

# Host port for the site. Set to 80 to reach it at
# http://cw_CompliancePartnercore.internal.coreweave.com/ with a hosts entry.
WEB_PORT=8080

# Run the images main publishes instead of building locally (README: Published
# images). Unset: built from this checkout.
# WEB_IMAGE=ghcr.io/skanoongo/compliance-partner-web:latest
# RUNNER_IMAGE=ghcr.io/skanoongo/compliance-partner-runner:latest

# The timezone the clock in every screenshot reads in. Set it to the reviewer's
# zone so the evidence timestamps line up with the period being tested.
TZ=America/New_York

# The workspace that must be visible on every captured page. This is a safety
# check, not a preference: the capture aborts rather than collect evidence from
# the wrong workspace.
CAPTURE_WORKSPACE=Production

# Seconds to wait after each page load before shooting. Raise it if pages are
# still rendering when the screenshot is taken.
CAPTURE_SETTLE=4.0

# Virtual screen size. Wider gives more of the Workato table per shot and fewer
# scrolled parts per page.
SCREEN_W=1680
SCREEN_H=1050
