# Copy to .env and edit. Every value here is already the default.
#
#   cp .env.example .env

# Host port for the site. Set to 80 to reach it at
# http://cw_CompliancePartnercore.internal.coreweave.com/ with a hosts entry.
WEB_PORT=8080

# The timezone the clock in every screenshot reads in. Set it to the reviewer's
# zone so the evidence timestamps line up with the period being tested.
TZ=America/New_York

# The workspace that must be visible on every captured page. This is a safety
# check, not a preference: the capture aborts rather than collect evidence from
# the wrong workspace.
CAPTURE_WORKSPACE=Production

# Seconds to wait after each page load before shooting. Raise it if pages are
# still rendering when the screenshot is taken.
CAPTURE_SETTLE=4.0

# Virtual screen size. Wider gives more of the Workato table per shot and fewer
# scrolled parts per page.
SCREEN_W=1680
SCREEN_H=1050
